{
  "version": 2,
  "builds": [
    { "src": "api/score.js", "use": "@vercel/node", "config": { "includeFiles": "model/**" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/score", "dest": "/api/score.js" },
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(.+)", "dest": "/public/$1" }
  ]
}
